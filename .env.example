# OpenAI-compatible VLM endpoint (default: none set; e.g. a vLLM/ollama/OpenRouter base_url)
VLM_BASE_URL=
# Endpoint key (default: none set; ollama accepts any placeholder)
VLM_API_KEY=
# VLM model name (default: qwen2.5-vl-7b-instruct)
VLM_MODEL=
# Path to RDD2022-trained .pt weights (default: none set; absent → pothole eye disabled)
POTHOLE_MODEL_PATH=
# Street-model weights (default: yolov8n.pt, auto-downloaded on first use)
YOLO_STREET_WEIGHTS=
# Data directory override (default: data)
ROADFIX_DATA_DIR=
# Deterministic stub detections/verdicts for tests and no-GPU demos (default: off; set to 1 to enable)
ROADFIX_STUB_MODELS=
